{
  "name": "opscapsule",
  "productName": "OpsCapsule",
  "version": "0.4.0",
  "private": true,
  "description": "An isolated workspace for operations tooling and agent runtimes.",
  "author": "Erik Everts",
  "license": "MIT",
  "homepage": "https://github.com/erikeverts/OpsCapsule#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikeverts/OpsCapsule.git"
  },
  "bugs": {
    "url": "https://github.com/erikeverts/OpsCapsule/issues"
  },
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "clean": "node scripts/clean.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dev": "npm run build:main && concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:electron": "wait-on tcp:5173 && cross-env OPSCAPSULE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run clean && npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/main.cjs --external:electron --external:node-pty && esbuild src/main/terminal-worker.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/terminal-worker.cjs --external:node-pty --external:@anthropic-ai/sandbox-runtime --external:@anthropic-ai/sandbox-runtime/* && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/preload.cjs --external:electron",
    "build:renderer": "vite build --config vite.config.ts",
    "prepackage": "npm run check:node",
    "package": "npm run build && electron-forge package",
    "premake": "npm run check:node",
    "make": "npm run build && electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:terminal-worker": "npm run build:main && electron scripts/verify-terminal-worker.cjs",
    "preverify:package": "npm run check:node",
    "verify:package": "node scripts/verify-packaged-app.mjs",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "prepare:release": "node scripts/prepare-release-artifacts.mjs",
    "start": "npm run build && electron .",
    "postinstall": "node scripts/check-node-version.mjs && electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.76",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.4.3",
    "esbuild": "0.28.2",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wait-on": "9.1.0"
  }
}
